rules_version = '2';

// Phase 1: authentication & onboarding.
//
// Introduces the first two Firestore domains — /users (the protected
// role/account record) and /profiles (the owned application/profile
// content) — per ARCHITECTURE.md and FEATURE_SUPERCONNECTOR.md Phase 1.
// Every later phase adds its own narrowly-scoped `match` blocks instead
// of loosening this file's defaults (see the catch-all at the bottom).
service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------
    // Shared helpers
    // -----------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // The caller's own account record. There is no Cloud Functions
    // backend on the Spark plan to mint custom auth claims, so looking
    // up role/batch via a Firestore doc read is the zero-cost
    // alternative — see CLAUDE.md / ARCHITECTURE.md. Only ever called
    // when isSignedIn() is already known true.
    function callerRecord() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function callerRole() {
      return isSignedIn() ? callerRecord().role : null;
    }

    function callerAssignedBatches() {
      return isSignedIn() ? callerRecord().get('assignedBatches', []) : [];
    }

    function isAdminRole(role) {
      return role in ['applicationAdmin', 'platformAdmin', 'superAdmin'];
    }

    // True when the signed-in caller may review the given `resource`
    // (a /users/{uid} or /profiles/{uid} doc carrying a batchId field):
    // any admin role, unconditionally, or a batch moderator scoped to
    // the resource's own batchId. Granting admin/moderator roles
    // themselves — and assigning a moderator's batches — is Phase 11
    // (Admin, moderators & analytics); for Phase 1 that assignment is
    // made by the owner directly in the Firebase Console, which is not
    // subject to these rules.
    function canReview(resource) {
      let role = callerRole();
      return isAdminRole(role)
        || (role == 'batchModerator' && resource.data.batchId in callerAssignedBatches());
    }

    // -----------------------------------------------------------------
    // /users/{uid} — account + role record. `role` is the single
    // protected authorization field (CLAUDE.md: "never expose hidden
    // ELO/Connection Meter or allow clients to edit it... never allow
    // client role escalation"). Clients may only ever:
    //   - create their own doc with role == 'pending' (self-declared,
    //     the lowest privilege — not an escalation);
    //   - as themselves, move rejected -> pending (ask for another
    //     look, changes no other field);
    //   - as an authorized reviewer, move someone else's pending ->
    //     member or pending -> rejected, stamping who reviewed it.
    // Every other transition (including any path to an admin/moderator
    // role) is denied by the catch-all below.
    // -----------------------------------------------------------------
    match /users/{uid} {
      allow get, list: if isSelf(uid) || canReview(resource);

      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == 'pending'
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.batchId is string
        && request.resource.data.batchId.size() > 0
        && (request.resource.data.email is string || request.resource.data.email == null)
        && request.resource.data.keys().hasOnly(
             ['uid', 'email', 'displayName', 'batchId', 'role', 'createdAt', 'updatedAt']);

      allow update: if
        // Self: ask for another review after rejection. Nothing else
        // about the record changes.
        (isSelf(uid)
          && resource.data.role == 'rejected'
          && request.resource.data.role == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['role', 'rejectionReason', 'updatedAt']))
        ||
        // Reviewer decision, scoped to the reviewer's own authority.
        (canReview(resource)
          && resource.data.role == 'pending'
          && request.resource.data.role in ['member', 'rejected']
          && request.resource.data.reviewedBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['role', 'reviewedBy', 'reviewedAt', 'rejectionReason', 'updatedAt']));

      allow delete: if false;
    }

    // -----------------------------------------------------------------
    // /profiles/{uid} — the application/profile content the person
    // filled in. Create-only from the client in Phase 1. Phase 2
    // ("Profiles & batch management") adds controlled self-editing
    // below: the owner may update their own profile content, but
    // `uid`, `batchId`, and `createdAt` stay frozen — `batchId` in
    // particular must never drift from the denormalized copy on
    // `/users/{uid}` that batch-moderator review-queue queries rely
    // on (see Phase 1's ProfileApplication doc comment). Reviewers get
    // no update path here at all; review decisions only ever touch
    // `/users/{uid}` (role/reviewedBy/reviewedAt), never profile
    // content — consistent with least privilege.
    // -----------------------------------------------------------------
    match /profiles/{uid} {
      allow get: if isSelf(uid) || canReview(resource);
      allow list: if false; // Phase 3 (directory/search) adds scoped queries.

      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.batchId is string && request.resource.data.batchId.size() > 0
        && request.resource.data.photoDataUrl is string
        && request.resource.data.photoDataUrl.size() > 0
        // Keep comfortably under Firestore's ~1 MiB document limit —
        // matches MAX_PHOTO_DATA_URL_LENGTH in
        // src/domain/onboarding/photo.ts.
        && request.resource.data.photoDataUrl.size() < 200000
        && request.resource.data.keys().hasOnly([
             'uid', 'name', 'photoDataUrl', 'batchId', 'location', 'education',
             'currentOrganization', 'previousOrganizations', 'skills', 'interests',
             'networkingGoals', 'createdAt', 'updatedAt']);

      allow update: if isSelf(uid)
        // Protected/frozen fields: identical to what's already stored.
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.batchId == resource.data.batchId
        && request.resource.data.createdAt == resource.data.createdAt
        // Same content validation as create.
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.photoDataUrl is string
        && request.resource.data.photoDataUrl.size() > 0
        && request.resource.data.photoDataUrl.size() < 200000
        && request.resource.data.keys().hasOnly([
             'uid', 'name', 'photoDataUrl', 'batchId', 'location', 'education',
             'currentOrganization', 'previousOrganizations', 'skills', 'interests',
             'networkingGoals', 'createdAt', 'updatedAt']);

      allow delete: if false;
    }

    // Everything else stays denied — later phases add their own
    // narrowly-scoped match blocks here instead of loosening this.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
