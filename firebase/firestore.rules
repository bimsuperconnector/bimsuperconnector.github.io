rules_version = '2';

// Phase 0 baseline: deny-by-default. Only the `users/{uid}` collection
// exists so far, and it is locked down to the bare minimum needed for
// the sign-in -> pending-review architecture to work end to end:
//
//   - A signed-in user may read only their own user document.
//   - A signed-in user may create their own user document exactly once,
//     and only with role "pending" — they can never self-approve.
//   - No client may update or delete a user document. Role transitions
//     (pending -> member, batch moderator assignment, rejection, etc.)
//     are a protected workflow built out in Phase 1 and Phase 11; until
//     that logic and its own rules exist, updates stay fully closed
//     rather than left open "temporarily."
//
// Every other collection in ARCHITECTURE.md (profiles, batches, jobs,
// events, matches, connection_scores, etc.) does not exist yet and is
// covered by the final catch-all deny rule. Each phase that introduces a
// new collection must add its own explicit, least-privilege rules here
// — never widen the catch-all.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.role == 'pending';

      allow update: if false;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
