rules_version = '2';

// Phase 0 foundation rules: deny-by-default.
//
// No collections are read from or written to by the client yet — Phase 0
// only ships the app shell, routing, and Firebase client initialization.
// Every later phase (starting with Phase 1: Authentication & onboarding)
// must add its own narrowly-scoped rules below, per CLAUDE.md section 7
// and SECURITY_AND_TESTING.md. Rules remain the authoritative
// authorization boundary — never the UI.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
