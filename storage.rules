rules_version = '2';

// Phase 0 foundation rules: deny-by-default.
//
// Profile photo upload paths are introduced in Phase 1 (Authentication &
// onboarding) with strict ownership/content-type/size checks. Nothing is
// stored yet, so nothing is allowed yet.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
